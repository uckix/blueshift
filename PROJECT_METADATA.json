  "supportedPlatforms": [
    "Linux (Host: Arch, Debian, Ubuntu, Parrot, Fedora, RHEL, Gentoo)",
    "Target: Any device supporting Bluetooth HID (Linux, macOS, Windows, Android, iPadOS)"
  ],
  "architectureRequirements": {
    "host": {
      "kernel": "Linux >= 5.8 (with evdev and uinput support)",
      "bluetoothStack": "BlueZ >= 5.50 (with experimental LE Peripheral mode enabled)",
      "adapter": "Bluetooth 4.2+ (BLE 5.0+ recommended for lowest latency)"
    },
    "target": {
      "hardware": "Standard Bluetooth 4.0+ receiver",
      "software": "Zero installation required (Driverless standard HID peripheral)"
    }
  },
  "defaultHotkeys": [
    "ScrollLock (Single-tap toggle)",
    "Ctrl + Alt + S (Chord toggle)",
    "Pause / Break (Alternative toggle)"
  ],
  "cliCommands": {
    "daemon": "blueshift daemon --run",
    "gui": "blueshift gui",
    "switch": "blueshift switch [host|target|toggle]",
    "status": "blueshift status",
    "doctor": "blueshift doctor",
    "pair": "blueshift pair --target <MAC_ADDRESS>"
  }
}
