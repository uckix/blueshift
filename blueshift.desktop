[Desktop Entry]
Version=1.0
Type=Application
Name=BlueShift
GenericName=Keyboard & Mouse Sharing
Comment=Use one keyboard and mouse on two Linux PCs over Bluetooth
Exec=blueshift
Icon=blueshift
Terminal=false
Categories=Utility;System;
Keywords=bluetooth;ble;kvm;keyboard;mouse;switch;share;
StartupNotify=true
Actions=Toggle;

[Desktop Action Toggle]
Name=Switch keyboard & mouse
Exec=blueshift toggle
