[Unit]
Description=BlueShift BLE KVM Client Auto-Reconnect Daemon
Documentation=https://github.com/blueshift/blueshift
After=bluetooth.target dbus.service
Wants=bluetooth.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/blueshift --client
Restart=always
RestartSec=4
KillMode=process
TimeoutStopSec=5

[Install]
WantedBy=default.target
