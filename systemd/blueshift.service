[Unit]
Description=BlueShift - Bluetooth keyboard & mouse sharing
Documentation=https://github.com/uckix/blueshift
After=bluetooth.target dbus.service
Wants=bluetooth.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/blueshift daemon
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=default.target
